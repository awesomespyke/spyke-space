#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_DIR"

python3 - "$PROJECT_DIR" <<'PY'
import re
import subprocess
import sys
import time
from pathlib import Path

project = Path(sys.argv[1])

frame_page = project / "content/page/frame.md"
labels_file = project / "data/frame_labels.yaml"
collections_file = project / "data/frame_collections.yaml"

text = frame_page.read_text()

# Determine what is actually visible in Frame.
collection_match = re.search(
    r'^collection:\s*["\']?(.+?)["\']?\s*$',
    text,
    re.MULTILINE,
)

if collection_match:
    collection_name = collection_match.group(1)

    lines = collections_file.read_text().splitlines()
    in_collection = False
    in_residents = False
    interval = None
    residents = []

    for line in lines:
        if line and not line.startswith(" "):
            if in_collection:
                break
            in_collection = line == f"{collection_name}:"
            in_residents = False
            continue

        if not in_collection:
            continue

        interval_match = re.match(r'^\s{2}interval:\s*(\d+)\s*$', line)
        if interval_match:
            interval = int(interval_match.group(1))
            continue

        if re.match(r'^\s{2}residents:\s*$', line):
            in_residents = True
            continue

        if in_residents:
            resident_match = re.match(r'^\s{4}-\s*["\']?(.+?)["\']?\s*$', line)
            if resident_match:
                residents.append(resident_match.group(1))

    if interval is None or not residents:
        sys.exit(f"Could not determine the current resident in collection: {collection_name}")

    index = int(time.time() // interval) % len(residents)
    filename = Path(residents[index]).name

else:
    image_match = re.search(
        r'^image:\s*["\']?/frame/(.+?)["\']?\s*$',
        text,
        re.MULTILINE,
    )

    if not image_match:
        sys.exit("Could not determine the current Frame resident.")

    filename = Path(image_match.group(1)).name

existing = {
    "title": "",
    "creator": "",
    "origin": "",
    "source": "",
}

if labels_file.exists():
    lines = labels_file.read_text().splitlines()
    current = None

    for line in lines:
        if line and not line.startswith(" "):
            current = line[:-1] if line.endswith(":") else None
        elif current == filename:
            field = re.match(
                r'^\s{2}(title|creator|origin|source):\s*"(.*)"\s*$',
                line,
            )
            if field:
                existing[field.group(1)] = (
                    field.group(2)
                    .replace('\\"', '"')
                    .replace('\\\\', '\\')
                )

def ask(label, default):
    script = '''
    on run argv
        set promptText to item 1 of argv
        set defaultText to item 2 of argv
        set answer to display dialog promptText default answer defaultText buttons {"Cancel", "OK"} default button "OK"
        return text returned of answer
    end run
    '''

    result = subprocess.run(
        ["osascript", "-e", script, label, default],
        capture_output=True,
        text=True,
    )

    if result.returncode != 0:
        sys.exit(0)

    return result.stdout.rstrip("\n")

title = ask("Title", existing["title"])
creator = ask("Creator", existing["creator"])
origin = ask("Origin · date", existing["origin"])
source = ask("Source / collection", existing["source"])

def quote(value):
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'

records = {}
order = []

if labels_file.exists():
    current = None

    for line in labels_file.read_text().splitlines():
        if line and not line.startswith(" "):
            current = line[:-1] if line.endswith(":") else None

            if current:
                order.append(current)
                records[current] = {}

        elif current:
            field = re.match(
                r'^\s{2}(title|creator|origin|source):\s*"(.*)"\s*$',
                line,
            )

            if field:
                records[current][field.group(1)] = field.group(2)

if filename not in records:
    order.append(filename)

records[filename] = {
    "title": title,
    "creator": creator,
    "origin": origin,
    "source": source,
}

output = []

for name in order:
    output.append(f"{name}:")
    record = records[name]

    for field in ("title", "creator", "origin", "source"):
        output.append(f"  {field}: {quote(record.get(field, ''))}")

labels_file.write_text("\n".join(output) + "\n")
PY

git add data/frame_labels.yaml

if git diff --cached --quiet; then
    echo "Label unchanged."
    exit 0
fi

git commit -m "Update Frame resident label"
git push

echo
echo "Frame label published."
