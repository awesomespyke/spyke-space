#!/bin/bash

set -e

if [ "$#" -ne 1 ]; then
    echo "Usage: frame <media>"
    exit 1
fi

MEDIA="$1"

if [ ! -f "$MEDIA" ]; then
    echo "Image not found: $MEDIA"
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
FRAME_DIR="$PROJECT_DIR/static/frame"

cd "$PROJECT_DIR"

UNRELATED_CHANGES="$(
    git status --porcelain |
    grep -vE ' (content/page/frame\.md|layouts/page/frame\.html|static/frame/|scripts/)' ||
    true
)"

if [ -n "$UNRELATED_CHANGES" ]; then
    echo "Frame stopped: spyke.space has unrelated changes:"
    echo "$UNRELATED_CHANGES"
    echo
    echo "Commit or resolve those changes first."
    exit 1
fi

git pull --rebase

ORIGINAL_FILENAME="$(basename "$MEDIA")"

FILENAME="$(python3 - "$ORIGINAL_FILENAME" <<'PY'
import sys
import unicodedata

name = sys.argv[1]
name = unicodedata.normalize("NFKD", name)
name = name.encode("ascii", "ignore").decode("ascii")
print(name)
PY
)"

DESTINATION="$FRAME_DIR/$FILENAME"

mkdir -p "$FRAME_DIR"

EXTENSION="${FILENAME##*.}"
EXTENSION="$(echo "$EXTENSION" | tr '[:upper:]' '[:lower:]')"

if [ "$(cd "$(dirname "$MEDIA")" && pwd)/$(basename "$MEDIA")" != "$DESTINATION" ]; then
    if [[ "$EXTENSION" == "mp4" || "$EXTENSION" == "mov" ]]; then
        echo "Preparing video for Frame..."
        /opt/homebrew/bin/ffmpeg -y -i "$MEDIA" \
            -c:v libx264 \
            -crf 24 \
            -preset medium \
            -an \
            -movflags +faststart \
            "$DESTINATION"
    else
        cp "$MEDIA" "$DESTINATION"
    fi
fi

if [[ "$EXTENSION" == "glb" ]]; then
    ORIENTATION="landscape"

elif [[ "$EXTENSION" == "mp4" || "$EXTENSION" == "mov" ]]; then
    WIDTH="$(/opt/homebrew/bin/ffprobe -v error -select_streams v:0 -show_entries stream=width -of csv=p=0 "$DESTINATION")"
    HEIGHT="$(/opt/homebrew/bin/ffprobe -v error -select_streams v:0 -show_entries stream=height -of csv=p=0 "$DESTINATION")"

    if [ "$HEIGHT" -gt "$WIDTH" ]; then
        ORIENTATION="portrait"
    else
        ORIENTATION="landscape"
    fi

else
    WIDTH="$(sips -g pixelWidth "$DESTINATION" | awk '/pixelWidth/ {print $2}')"
    HEIGHT="$(sips -g pixelHeight "$DESTINATION" | awk '/pixelHeight/ {print $2}')"

    if [ "$HEIGHT" -gt "$WIDTH" ]; then
        ORIENTATION="portrait"
    else
        ORIENTATION="landscape"
    fi
fi

FRAME_PAGE="$PROJECT_DIR/content/page/frame.md"

python3 - "$FRAME_PAGE" "$FILENAME" "$ORIENTATION" "$EXTENSION" <<'PY'
import sys
from pathlib import Path

page = Path(sys.argv[1])
filename = sys.argv[2]
orientation = sys.argv[3]
extension = sys.argv[4]

if extension in ("mp4", "mov"):
    media_type = "video"
elif extension == "glb":
    media_type = "model"
else:
    media_type = "image"

text = page.read_text()

lines = []
for line in text.splitlines():
    if line.startswith("image:"):
        line = f'image: "/frame/{filename}"'
    elif line.startswith("orientation:"):
        line = f'orientation: "{orientation}"'
    elif line.startswith("type:"):
        line = f'type: "{media_type}"'
    elif line.startswith("collection:"):
        continue
    lines.append(line)

if not any(line.startswith("type:") for line in lines):
    lines.insert(-1, f'type: "{media_type}"')

page.write_text("\n".join(lines) + "\n")
PY

echo "Resident:"
echo "$FILENAME"
echo "Orientation: $ORIENTATION"

git add content/page/frame.md "static/frame/$FILENAME"

git commit -m "Change Frame resident to ${FILENAME%.*}"

git push

echo
echo "Published to Frame."
